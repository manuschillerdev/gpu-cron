{
  "name": "gpu-cron",
  "version": "0.1.0",
  "description": "Tiny MLX-trained schedule model with a dependency-free WebGPU runtime",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "MODEL_CARD.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsgo -p tsconfig.build.json",
    "build:demo": "vite build",
    "typecheck": "pnpm run build && tsgo --noEmit",
    "test": "pnpm run typecheck && node --test test/*.test.ts",
    "test:browser": "pnpm run typecheck && pnpm run build:demo && node test/browser.ts",
    "train": "uv run --locked --project training python training/train.py",
    "prepare:cron-data": "uv run --locked --project training python training/data.py",
    "evaluate:cron": "pnpm run build && node training/evaluate.mjs",
    "evaluate:cron:holdout": "pnpm run build && node training/evaluate.mjs --holdout",
    "size": "pnpm run build && node test/size.ts",
    "check": "pnpm run check:python && pnpm run typecheck && node --test test/*.test.ts && pnpm run build:demo && node test/browser.ts && node training/evaluate.mjs --check && node test/size.ts",
    "evaluate:cron:candidate": "node training/evaluate.mjs --candidate --check",
    "promote:cron": "node training/promote.mjs",
    "check:python": "mise run check:python",
    "format": "prettier --write 'src/**/*.ts' 'demo/**/*.{ts,css}' index.html 'test/**/*.ts' training/evaluate.mjs training/promote.mjs && uv run --locked --project training ruff format training"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@webgpu/types": "^0.1.69",
    "playwright": "^1.58.2",
    "prettier": "3.9.6",
    "vite": "^7.3.1"
  },
  "packageManager": "pnpm@10.32.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/manuschillerdev/gpu-cron.git"
  },
  "homepage": "https://github.com/manuschillerdev/gpu-cron#readme",
  "bugs": {
    "url": "https://github.com/manuschillerdev/gpu-cron/issues"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
